{% comment %}
  Record of Assessment, after the MRPAAO Attachment 9 (p.166–167). Superseded manual: reference
  layout (docs/analysis/mrpaao-forms-model.md §15). Rows are derived from the
  FAAS in force on the run's date; issuing the run freezes them.
{% endcomment %}
{% assign r = register %}
<style>
  @page { size: landscape; }
  .src { font-size: 8pt; border: 1px solid #555; padding: 2px 6px; margin-bottom: 6px; }
  .draft { border: 2px solid #b00; color: #b00; font-weight: bold; text-align: center; padding: 3px; margin-bottom: 6px; }
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 6px; }
  .lgu { text-align: center; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 8pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: center; }
  .num { text-align: right; white-space: nowrap; }
  .hd td { border: none; font-size: 9pt; padding: 1px 4px; }
  .empty { text-align: center; font-style: italic; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
<div class="src">Layout: MRPAAO 2004, Attachment 9 — superseded by the Local Assessment Manual; reference layout. Form {{ form.code }} v{{ form.version }}.</div>
{% if r.formCode != form.code %}<div class="draft">This run is a {{ r.kind }} register; print it with form {{ r.formCode }}.</div>{% endif %}
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}
<h1>RECORD OF ASSESSMENT</h1>
<table class="hd">
  <tr><td>Province: <b>{{ r.province }}</b> <small>({{ r.provinceCode | default: "—" }})</small></td>
      <td>City/Municipality: <b>{{ r.municipality }}</b> <small>({{ r.municipalityCode | default: "—" }})</small></td>
      <td>Barangay: <b>{{ r.barangay }}</b> <small>({{ r.barangayCode | default: "—" }})</small></td>
      <td>As of <b>{{ r.asOf | date_ph }}</b></td></tr>
</table>
<table class="hd"><tr><td>Classification: <b>{{ r.classification }}</b> ({{ r.classificationCode }})</td>
  <td>Period: <b>{% if r.fromDate %}{{ r.fromDate | date_ph }}{% else %}beginning{% endif %} to {{ r.asOf | date_ph }}</b></td></tr></table>
<table>
  <tr><th rowspan="2">Date</th><th rowspan="2">ARP No.</th><th rowspan="2">TD No.</th><th rowspan="2">Declared Owner</th><th rowspan="2">PIN</th><th rowspan="2">Location</th>
      <th colspan="2">Land Area</th><th colspan="3">Market Value</th><th colspan="3">Assessed Value</th><th rowspan="2">Year Taxes Begin</th><th rowspan="2">Trans. Code</th></tr>
  <tr><th>Taxable</th><th>Exempt</th><th>Land</th><th>Bldg</th><th>Mach.</th><th>Land</th><th>Bldg</th><th>Mach.</th></tr>
  {% assign ml = 0 %}{% assign mb = 0 %}{% assign mm = 0 %}{% assign al = 0 %}{% assign ab = 0 %}{% assign am = 0 %}{% assign ta = 0 %}{% assign ea = 0 %}
  {% for x in rows %}
  {% if x.marketValueL %}{% assign ml = ml | plus: x.marketValueL %}{% endif %}{% if x.marketValueB %}{% assign mb = mb | plus: x.marketValueB %}{% endif %}{% if x.marketValueM %}{% assign mm = mm | plus: x.marketValueM %}{% endif %}
  {% if x.assessedValueL %}{% assign al = al | plus: x.assessedValueL %}{% endif %}{% if x.assessedValueB %}{% assign ab = ab | plus: x.assessedValueB %}{% endif %}{% if x.assessedValueM %}{% assign am = am | plus: x.assessedValueM %}{% endif %}
  {% if x.landArea %}{% if x.taxable %}{% assign ta = ta | plus: x.landArea %}{% else %}{% assign ea = ea | plus: x.landArea %}{% endif %}{% endif %}
  <tr><td>{{ x.date | date_ph }}</td><td>{{ x.arpNumber | default: "—" }}</td><td>{{ x.tdNumber }}</td><td>{{ x.owner }}</td><td>{{ x.pin }}</td><td>{{ x.location }}</td>
      <td class="num">{% if x.landArea %}{% if x.taxable %}{{ x.landArea | num }}{% endif %}{% endif %}</td>
      <td class="num">{% if x.landArea %}{% unless x.taxable %}{{ x.landArea | num }}{% endunless %}{% endif %}</td>
      <td class="num">{% if x.marketValueL %}{{ x.marketValueL | money }}{% endif %}</td><td class="num">{% if x.marketValueB %}{{ x.marketValueB | money }}{% endif %}</td><td class="num">{% if x.marketValueM %}{{ x.marketValueM | money }}{% endif %}</td>
      <td class="num">{% if x.assessedValueL %}{{ x.assessedValueL | money }}{% endif %}</td><td class="num">{% if x.assessedValueB %}{{ x.assessedValueB | money }}{% endif %}</td><td class="num">{% if x.assessedValueM %}{{ x.assessedValueM | money }}{% endif %}</td>
      <td>{{ x.yearTaxesBegin | default: "exempt" }}</td><td>{{ x.transactionCode }}</td></tr>
  {% else %}<tr><td colspan="16" class="empty">No assessment of this classification was recorded in this barangay in the period.</td></tr>{% endfor %}
  <tr><td colspan="6" class="num"><b>TOTAL ({{ rows | size }})</b></td><td class="num"><b>{{ ta | num }}</b></td><td class="num"><b>{{ ea | num }}</b></td>
      <td class="num"><b>{{ ml | money }}</b></td><td class="num"><b>{{ mb | money }}</b></td><td class="num"><b>{{ mm | money }}</b></td>
      <td class="num"><b>{{ al | money }}</b></td><td class="num"><b>{{ ab | money }}</b></td><td class="num"><b>{{ am | money }}</b></td><td colspan="2"></td></tr>
</table>
<p style="font-size:8pt">Each FAAS entered (TD approved) in the period is one line; a cancelled declaration stays on the record of the period it was entered in.</p>
<table class="hd" style="margin-top:28px"><tr><td style="width:50%"></td>
  <td style="text-align:center"><div style="border-top:1px solid #000; display:inline-block; min-width:260px; padding-top:2px">Provincial/City/Municipal Assessor</div></td></tr></table>
<div class="foot">Location codes are PSGC codes (the manual's location index numbers are not recorded — DOMAIN VERIFICATION REQUIRED).
  {% if r.remarks %}Remarks: {{ r.remarks }}. {% endif %}Printed {{ issue.issuedAt | date_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}. {{ form.legalBasis }}.</div>
