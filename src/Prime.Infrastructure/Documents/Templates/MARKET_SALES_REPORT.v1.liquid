{% comment %}
  PRIME provisional layout (docs/analysis/smv-preparation-general-revision.md §4.1): lowest, median and highest
  recorded sales per kind, class and sub-class (LAM 2025 Book I p.25; the official annex form is loaded as content when
  adopted; its frequency, yearly or every three years, is question E6). Accepted sales only, by unit price.
{% endcomment %}
{% assign r = report %}
<style>
  @page { size: landscape; }
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 2px; }
  .lgu { text-align: center; font-weight: bold; }
  .sub { text-align: center; font-size: 9pt; margin-bottom: 6px; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 7.5pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: center; }
  .num { text-align: right; white-space: nowrap; }
  .empty { text-align: center; font-style: italic; }
  .sig { margin-top: 26px; width: 260px; border-top: 1px solid #000; text-align: center; font-size: 8.5pt; padding-top: 2px; display: inline-block; margin-right: 60px; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}{% if lgu.office %}<div class="sub">{{ lgu.office }}</div>{% endif %}
<h1>REPORT OF LOWEST TO HIGHEST RECORDED SALES OF REAL PROPERTIES</h1>
<div class="sub">{{ r.municipality }}{% if r.province %}, {{ r.province }}{% endif %} · {{ r.fromDate | date_ph }} to {{ r.toDate | date_ph }}</div>
<table>
  <tr><th>Kind</th><th>Classification</th><th>Sub-class / type of building</th><th>Unit</th><th>Sales</th><th>Lowest</th><th>Median</th><th>Highest</th></tr>
  {% for g in data.groups %}
  <tr><td>{{ g.kind }}</td><td>{{ g.classification }}</td><td>{{ g.subClass }}</td><td>per {{ g.unit }}</td><td class="num">{{ g.count }}</td>
      <td class="num">{{ g.lowest | money }}</td><td class="num">{{ g.median | money }}</td><td class="num">{{ g.highest | money }}</td></tr>
  {% else %}<tr><td colspan="8" class="empty">No accepted sales in the period.</td></tr>{% endfor %}
</table>
<table>
  <tr><th>Kind</th><th>Date</th><th>Name of new owner</th><th>PIN</th><th>Location</th><th>Classification</th><th>Sub-class / type</th><th>Area</th><th>Unit price</th></tr>
  {% for s in data.sales %}
  <tr><td>{{ s.kind }}</td><td>{{ s.date | date_ph }}</td><td>{{ s.owner }}</td><td>{{ s.pin }}</td><td>{{ s.location }}</td><td>{{ s.classification }}</td>
      <td>{{ s.subClass }}</td><td class="num">{{ s.area }} {{ s.unit }}</td><td class="num">{{ s.unitPrice | money }}</td></tr>
  {% endfor %}
</table>
<div class="sig">Prepared by</div><div class="sig">Certified by: Assessor</div>
<div class="foot">{{ form.title }} — form {{ form.code }} v{{ form.version }}. {{ form.legalBasis }}. Printed {{ issue.issuedAt | datetime_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.{% if r.remarks %} Remarks: {{ r.remarks }}{% endif %}</div>
