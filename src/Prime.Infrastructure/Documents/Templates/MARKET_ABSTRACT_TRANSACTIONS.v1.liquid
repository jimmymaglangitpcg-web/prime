{% comment %}
  PRIME provisional layout (docs/analysis/smv-preparation-general-revision.md §4.1): the abstract of registered real
  property transactions for a city/municipality and period (LAM 2025 Book I p.22 describes it; the official annex form
  is loaded as content when the province adopts it). Recorded values only; cancelled records omitted.
{% endcomment %}
{% assign r = report %}
<style>
  @page { size: landscape; }
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 2px; }
  .lgu { text-align: center; font-weight: bold; }
  .sub { text-align: center; font-size: 9pt; margin-bottom: 6px; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 7.5pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: center; }
  .num { text-align: right; white-space: nowrap; }
  .empty { text-align: center; font-style: italic; }
  .sig { margin-top: 26px; width: 260px; border-top: 1px solid #000; text-align: center; font-size: 8.5pt; padding-top: 2px; display: inline-block; margin-right: 60px; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}{% if lgu.office %}<div class="sub">{{ lgu.office }}</div>{% endif %}
<h1>ABSTRACT OF REGISTERED REAL PROPERTY TRANSACTIONS</h1>
<div class="sub">{{ r.municipality }}{% if r.province %}, {{ r.province }}{% endif %} · {{ r.fromDate | date_ph }} to {{ r.toDate | date_ph }}</div>
<table>
  <tr><th>Date</th><th>From</th><th>To</th><th>Address of new owner</th><th>Location</th><th>Mode</th><th>Consideration</th>
      <th>L/B</th><th>Land area</th><th>Floor area</th><th>Lot</th><th>Previous title</th><th>New title</th><th>Document</th></tr>
  {% for t in data.transactions %}
  <tr><td>{{ t.date | date_ph }}</td><td>{{ t.from }}</td><td>{{ t.to }}</td><td>{{ t.toAddress }}</td><td>{{ t.location }}</td><td>{{ t.mode }}</td>
      <td class="num">{{ t.consideration | money }}</td><td>{% if t.land %}L{% endif %}{% if t.building %}B{% endif %}</td>
      <td class="num">{% if t.landArea %}{{ t.landArea }} {{ t.landAreaUnit }}{% endif %}</td><td class="num">{{ t.floorArea }}</td>
      <td>{{ t.lot }}</td><td>{{ t.previousTitle }}</td><td>{{ t.newTitle }}</td><td>{{ t.document }}</td></tr>
  {% else %}<tr><td colspan="14" class="empty">No transactions recorded in the period.</td></tr>{% endfor %}
</table>
<div class="sig">Prepared by</div><div class="sig">Assessor</div>
<div class="foot">{{ form.title }} — form {{ form.code }} v{{ form.version }}. {{ form.legalBasis }}. Printed {{ issue.issuedAt | datetime_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.{% if r.remarks %} Remarks: {{ r.remarks }}{% endif %}</div>
