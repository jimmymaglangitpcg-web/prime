{% comment %}
  Tax Map Control Roll (post-TMCR), after the MRPAAO Attachment 5 (p.158–159) and
  Ch. II Figure 10 (p.70). Superseded manual: reference layout
  (docs/analysis/property-identification.md §3.5). One roll per tax map section, in
  PIN order; retired PINs are noted. A run without a section lists the barangay.
  Rows are derived from the FAAS in force on the run's date; issuing freezes them.
{% endcomment %}
{% assign r = register %}
{% assign ix = r.index %}
<style>
  @page { size: landscape; }
  .src { font-size: 8pt; border: 1px solid #555; padding: 2px 6px; margin-bottom: 6px; }
  .draft { border: 2px solid #b00; color: #b00; font-weight: bold; text-align: center; padding: 3px; margin-bottom: 6px; }
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 6px; }
  .lgu { text-align: center; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 8pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: center; }
  .num { text-align: right; white-space: nowrap; }
  .hd td { border: none; font-size: 9pt; padding: 1px 4px; }
  .empty { text-align: center; font-style: italic; }
  .retired td { color: #555; font-style: italic; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
<div class="src">Layout: MRPAAO 2004, Attachment 5 / Ch. II Figure 10 — superseded by the Local Assessment Manual; reference layout. Form {{ form.code }} v{{ form.version }}.</div>
{% if r.formCode != form.code %}<div class="draft">This run is a {{ r.kind }} register; print it with form {{ r.formCode }}.</div>{% endif %}
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}
<h1>TAX MAP CONTROL ROLL</h1>
<table class="hd">
  <tr><td>Prov./City: <b>{{ ix.lguName | default: r.province }}</b> (Index No. <b>{{ ix.lgu | default: "—" }}</b>)</td>
      <td>Mun./District: <b>{{ ix.municipalityName | default: "—" }}</b> (Index No. <b>{{ ix.municipality | default: "—" }}</b>)</td>
      <td>As of <b>{{ r.asOf | date_ph }}</b></td></tr>
  <tr><td>Barangay: <b>{{ r.barangay }}</b> (Index No. <b>{{ ix.barangay | default: "—" }}</b>)</td>
      <td>Section Index No. <b>{{ ix.section | default: "— (whole barangay)" }}</b>{% if r.sectionRetiredOn %} <i>(section retired {{ r.sectionRetiredOn | date_ph }})</i>{% endif %}</td>
      <td></td></tr>
</table>
<table>
  <tr><th rowspan="2">Assessor's Lot No.</th><th colspan="4">Land</th><th rowspan="2">Class Code</th><th rowspan="2">Name of Owner</th><th rowspan="2">ARP No.</th><th rowspan="2">TD No.</th>
      <th rowspan="2">Bldg. / Structure</th><th rowspan="2">Machinery</th><th rowspan="2">Other</th><th rowspan="2">Remarks</th></tr>
  <tr><th>Survey Lot No.</th><th>Lot / Blk</th><th>Title No.</th><th>Area</th></tr>
  {% for x in rows %}
  {% if x.retired %}
  <tr class="retired"><td>{{ x.assessorLotNumber }}</td><td colspan="11">PIN {{ x.pin }} — retired</td><td>{{ x.remarks }}</td></tr>
  {% else %}
  <tr><td>{{ x.assessorLotNumber }}</td><td>{{ x.surveyNumber | default: "—" }}</td><td>{{ x.lotNumber | default: "—" }} / {{ x.blockNumber | default: "—" }}</td>
      <td>{{ x.titleNumber | default: "—" }}</td><td class="num">{% if x.area %}{{ x.area | num }} {{ x.areaUnit }}{% else %}—{% endif %}</td>
      <td>{{ x.classCode }}</td><td>{{ x.owner }}</td><td>{{ x.arpNumber | default: "—" }}</td><td>{{ x.tdNumber | default: "—" }}</td>
      <td class="num">{{ x.buildings }}</td><td style="text-align:center">{% if x.machinery %}X{% else %}0{% endif %}</td>
      <td>{{ x.others }}</td><td>{{ x.remarks }}</td></tr>
  {% endif %}
  {% else %}<tr><td colspan="13" class="empty">No parcel is listed in this {% if ix.section %}section{% else %}barangay{% endif %} as of this date.</td></tr>{% endfor %}
</table>
<p style="font-size:8pt">Entries: <b>{{ rows | size }}</b>.</p>
<table class="hd" style="margin-top:28px"><tr><td style="width:50%"></td>
  <td style="text-align:center"><div style="border-top:1px solid #000; display:inline-block; min-width:260px; padding-top:2px">Chief, Tax Mapping Division / Assessor</div></td></tr></table>
<div class="foot">Index numbers are the assessor's (Ch. II §1); "—" where not yet set. A retired PIN is never reused (Ch. II §1 D.4).
  {% if r.remarks %}Remarks: {{ r.remarks }}. {% endif %}Printed {{ issue.issuedAt | date_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}. {{ form.legalBasis }}.</div>
