{% comment %}
  PRIME provisional layout (docs/analysis/smv-preparation-general-revision.md §4.6, L6-6c): the general revision status report
  submitted on completion (LAM 2025 Book I p.25 describes it; the annex form is loaded as content when adopted). DOMAIN
  VERIFICATION REQUIRED: its fields. Recorded values only.
{% endcomment %}
{% assign v = revision %}
<style>
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 2px; }
  .lgu { text-align: center; font-weight: bold; }
  .sub { text-align: center; font-size: 9pt; margin-bottom: 6px; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 8pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: left; width: 45%; }
  .sig { margin-top: 26px; width: 260px; border-top: 1px solid #000; text-align: center; font-size: 8.5pt; padding-top: 2px; display: inline-block; margin-right: 60px; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}{% if lgu.office %}<div class="sub">{{ lgu.office }}</div>{% endif %}
<h1>GENERAL REVISION STATUS REPORT</h1>
<div class="sub">{{ v.scope | join: ", " }}{% if v.province %}, {{ v.province }}{% endif %}</div>
<table>
  <tr><th>Revision year / effectivity</th><td>{{ v.year }} / {{ v.effectiveDate | date_ph }}</td></tr>
  <tr><th>Schedule of market values applied</th><td>{{ v.smv }}</td></tr>
  <tr><th>Status</th><td>{{ v.status }}{% if v.completedOn %}, completed {{ v.completedOn | date_ph }}{% endif %}</td></tr>
  <tr><th>Units compiled / taken out / posted</th><td>{{ units.compiled }} / {{ units.excluded }} / {{ units.posted }}</td></tr>
  <tr><th>New Tax Declarations approved</th><td>{{ units.declared }}</td></tr>
  <tr><th>Units independently appraised</th><td>{{ units.independentlyAppraised }}</td></tr>
  <tr><th>Market value before → after</th><td>{{ totals.marketValueBefore | money }} → {{ totals.marketValueAfter | money }}</td></tr>
  <tr><th>Assessed value before → after</th><td>{{ totals.assessedValueBefore | money }} → {{ totals.assessedValueAfter | money }}</td></tr>
  <tr><th>Notices of assessment served / total</th><td>{{ notices.served }} / {{ notices.total }}</td></tr>
  <tr><th>Appeals</th><td>{{ appeals.note }}</td></tr>
</table>
<div class="sig">Assessor</div>
<div class="foot">{{ form.title }} — form {{ form.code }} v{{ form.version }}. {{ form.legalBasis }}. Printed {{ issue.issuedAt | datetime_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.</div>
