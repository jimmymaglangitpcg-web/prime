{% comment %}
  PRIME provisional layout (docs/analysis/smv-preparation-general-revision.md §4.1): the abstract of certificates of
  registration of installation of machinery (LGC §210; LAM 2025 Book I p.23; the official annex form is loaded as
  content when adopted). The assessed value is that of the declared machinery's latest posted assessment effective by
  the end of the period.
{% endcomment %}
{% assign r = report %}
<style>
  @page { size: landscape; }
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 2px; }
  .lgu { text-align: center; font-weight: bold; }
  .sub { text-align: center; font-size: 9pt; margin-bottom: 6px; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 7.5pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: center; }
  .num { text-align: right; white-space: nowrap; }
  .empty { text-align: center; font-style: italic; }
  .sig { margin-top: 26px; width: 260px; border-top: 1px solid #000; text-align: center; font-size: 8.5pt; padding-top: 2px; display: inline-block; margin-right: 60px; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}{% if lgu.office %}<div class="sub">{{ lgu.office }}</div>{% endif %}
<h1>ABSTRACT OF CERTIFICATES OF REGISTRATION OF INSTALLATION OF MACHINERY</h1>
<div class="sub">{{ r.municipality }}{% if r.province %}, {{ r.province }}{% endif %} · {{ r.fromDate | date_ph }} to {{ r.toDate | date_ph }}</div>
<table>
  <tr><th>Date issued</th><th>Certificate no.</th><th>Owner</th><th>Address of owner</th><th>Location</th><th>TD no.</th><th>Type</th>
      <th>Brand/model</th><th>Year acquired / manufacturer</th><th>Cost</th><th>Condition</th><th>Assessed value</th><th>Installed</th></tr>
  {% for m in data.registrations %}
  <tr><td>{{ m.issuedOn | date_ph }}</td><td>{{ m.number }}</td><td>{{ m.owner }}</td><td>{{ m.ownerAddress }}</td><td>{{ m.location }}</td>
      <td>{{ m.td }}</td><td>{{ m.type }}</td><td>{{ m.brandModel }}</td><td>{{ m.yearAcquired }} {{ m.manufacturer }}</td>
      <td class="num">{{ m.cost | money }}</td><td>{{ m.condition }}</td><td class="num">{{ m.assessedValue | money }}</td><td>{{ m.installedOn | date_ph }}</td></tr>
  {% else %}<tr><td colspan="13" class="empty">No certificates recorded in the period.</td></tr>{% endfor %}
</table>
<div class="sig">Prepared by</div><div class="sig">Assessor</div>
<div class="foot">{{ form.title }} — form {{ form.code }} v{{ form.version }}. {{ form.legalBasis }}. Printed {{ issue.issuedAt | datetime_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.{% if r.remarks %} Remarks: {{ r.remarks }}{% endif %}</div>
