{% comment %}
  PRIME provisional layout (docs/analysis/smv-preparation-general-revision.md §4.2, L6-2c): unit cost of extra items that are component parts of buildings.
  LAM 2025 Book IV pp.114–115 lists the form; its layout (Annex IV-L) is loaded as content and is not reproduced here.
  DOMAIN VERIFICATION REQUIRED: its columns.
{% endcomment %}
<style>
  h1 { font-size: 12pt; text-align: center; margin: 4px 0 2px; }
  h2 { font-size: 9.5pt; margin: 8px 0 3px; }
  .lgu { text-align: center; font-weight: bold; }
  .sub { text-align: center; font-size: 9pt; margin-bottom: 4px; }
  .flag { text-align: center; font-weight: bold; letter-spacing: 1px; border: 1px solid #000; padding: 2px; margin: 4px 0; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 7.5pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: left; }
  .num { text-align: right; white-space: nowrap; }
  .pre { white-space: pre-wrap; }
  .muted { color: #555; font-size: 7.5pt; }
  .sig { margin-top: 26px; width: 240px; border-top: 1px solid #000; text-align: center; font-size: 8.5pt; padding-top: 2px; display: inline-block; margin-right: 50px; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}{% if lgu.office %}<div class="sub">{{ lgu.office }}</div>{% endif %}
<h1>SMV FORM NO. 12 — SCHEDULE OF UNIT COST FOR EXTRA ITEMS AS COMPONENT PARTS OF BUILDING</h1>
<div class="sub">{% if smv.coverage.size > 0 %}{{ smv.coverage | join: ", " }}{% else %}Whole province{% endif %}{% if smv.province %}, {{ smv.province }}{% endif %}
 · Revision {{ smv.revisionYear }} · {% if smv.reference != "" %}{{ smv.reference }}{% else %}not yet certified{% endif %} · effective {{ smv.effectivityDate | date_ph }}</div>
{% if smv.proposed %}<div class="flag">PROPOSED — {{ smv.status }} in PRIME{% if smv.preparation %} · preparation: {{ smv.preparation.status }}{% endif %}</div>{% endif %}

<table>
  <tr><th>Extra item</th><th>Unit</th><th class="num">Unit cost</th><th>Status</th></tr>
  {% for r in extraItems %}<tr><td>{{ r.item }}</td><td>{{ r.unit }}</td><td class="num">{{ r.cost | money }}</td><td>{{ r.status }}</td></tr>{% endfor %}
  {% if extraItems.size == 0 %}<tr><td colspan="4" class="muted">No extra item cost in this SMV.</td></tr>{% endif %}
</table>
<div class="sig">Prepared by</div><div class="sig">Noted by: Assessor</div>
<div class="foot">{{ form.title }} — form {{ form.code }} v{{ form.version }}. {{ form.legalBasis }}. Printed {{ issue.issuedAt | datetime_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.</div>
