{% comment %}
  PRIME provisional receipt (docs/analysis/collection.md §5). Neutral layout
  built only from PRIME data; the official receipt layout (COA accountable
  form / BLGF eOR format) is DOMAIN VERIFICATION REQUIRED. Carries the eOR
  minimum content of DOF DO 054-2024 §7.1.
{% endcomment %}
{% assign p = payment %}
<style>
  .hdr { text-align: center; margin-bottom: 8px; }
  .hdr .lgu { font-weight: bold; font-size: 12pt; }
  .hdr h1 { font-size: 15pt; margin: 6px 0 2px; }
  table { width: 100%; border-collapse: collapse; margin: 6px 0; }
  th, td { border: 1px solid #555; padding: 3px 5px; font-size: 9.5pt; vertical-align: top; }
  th { background: #eee; text-align: left; }
  .num { text-align: right; white-space: nowrap; }
  .meta td { border: none; padding: 1px 4px; }
  .total td { font-weight: bold; }
  .words { font-style: italic; margin: 4px 0 8px; }
  .status { border: 2px solid #b00; color: #b00; font-weight: bold; text-align: center; padding: 4px; margin: 6px 0; }
  .foot { font-size: 8pt; color: #333; margin-top: 10px; }
  .sign { margin-top: 28px; width: 45%; margin-left: auto; text-align: center; border-top: 1px solid #000; padding-top: 2px; }
</style>
<div class="hdr">
  {% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% else %}<div class="lgu">[LGU name not configured]</div>{% endif %}
  {% if p.office %}<div>{{ p.office }}</div>{% else %}<div>[Collecting office not configured]</div>{% endif %}
  <h1>{{ form.title }}</h1>
</div>

{% if p.status != "Posted" %}<div class="status">{{ p.status | upcase }}</div>{% endif %}

<table class="meta">
  <tr><td><b>OR No.</b></td><td>{{ p.officialReceiptNumber }}</td><td><b>Transaction No.</b></td><td>{{ p.transactionNumber }}</td></tr>
  <tr><td><b>Date and time</b></td><td>{{ p.receivedAt | datetime_ph }}</td><td><b>Location code</b></td><td>{% if p.locationCode %}{{ p.locationCode }}{% else %}[not configured]{% endif %}</td></tr>
  <tr><td><b>Payor</b></td><td colspan="3">{{ p.payorName }}{% if p.payorAddress %}, {{ p.payorAddress }}{% endif %}</td></tr>
  <tr><td><b>Bill / TD No.</b></td><td colspan="3">{% for r in references %}{{ r }}{% unless forloop.last %}; {% endunless %}{% endfor %}</td></tr>
  {% if p.replacesOfficialReceiptNumber %}<tr><td><b>Replaces OR</b></td><td colspan="3">{{ p.replacesOfficialReceiptNumber }}</td></tr>{% endif %}
</table>

<table>
  <tr><th>Nature of collection</th><th>Account code</th><th>Fund</th><th class="num">Amount</th></tr>
  {% for a in accounts %}
  <tr><td>{{ a.name }}</td><td>{{ a.code }}</td><td>{{ a.fund }}</td><td class="num">{{ a.amount | money }}</td></tr>
  {% endfor %}
  <tr class="total"><td colspan="3" class="num">TOTAL</td><td class="num">{{ p.amountDue | money }}</td></tr>
</table>
<div class="words">{{ p.amountDue | amount_words }}</div>

<table>
  <tr><th>PIN</th><th>TD No.</th><th>Tax year</th><th>Inst.</th><th>Tax type</th><th>Component</th><th>Explanation</th><th class="num">Amount</th></tr>
  {% for l in lines %}
  <tr><td>{{ l.pin }}</td><td>{{ l.taxDeclarationNumber }}</td><td>{{ l.taxYear }}</td><td>{{ l.installment }}</td><td>{{ l.taxType }}</td>
      <td>{{ l.component }}</td><td>{{ l.explanation }}</td><td class="num">{{ l.amount | money }}</td></tr>
  {% endfor %}
</table>

<table>
  <tr><th>Mode of payment</th><th>Reference</th><th>Bank</th><th>Check date</th><th class="num">Amount</th></tr>
  {% for t in tenders %}
  <tr><td>{{ t.mode }}</td><td>{{ t.reference }}</td><td>{{ t.bank }}</td><td>{% if t.checkDate %}{{ t.checkDate | date_ph }}{% endif %}</td><td class="num">{{ t.amount | money }}</td></tr>
  {% endfor %}
  <tr><td colspan="4" class="num">Amount tendered</td><td class="num">{{ p.amountTendered | money }}</td></tr>
  <tr><td colspan="4" class="num">Change</td><td class="num">{{ p.change | money }}</td></tr>
</table>

<div class="sign">Collecting Officer</div>

<div class="foot">
  Printed {{ issue.issuedAt | datetime_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.
  Form {{ form.code }} v{{ form.version }} — {{ form.legalBasis }}.
</div>
