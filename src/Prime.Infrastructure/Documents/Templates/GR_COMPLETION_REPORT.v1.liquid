{% comment %}
  PRIME provisional layout (docs/analysis/smv-preparation-general-revision.md §4.6, L6-6c): the general revision's completion
  report to the local chief executive and the Sanggunian (GRI 19). Recorded values only, from the revision's units, the
  assessments they replaced and made, the notices and the register runs. The office's own layout is loaded as content when adopted.
{% endcomment %}
{% assign v = revision %}
<style>
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 2px; }
  h2 { font-size: 10pt; margin: 10px 0 3px; }
  .lgu { text-align: center; font-weight: bold; }
  .sub { text-align: center; font-size: 9pt; margin-bottom: 6px; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 8pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: center; }
  .num { text-align: right; white-space: nowrap; }
  .empty { text-align: center; font-style: italic; }
  .sig { margin-top: 26px; width: 260px; border-top: 1px solid #000; text-align: center; font-size: 8.5pt; padding-top: 2px; display: inline-block; margin-right: 60px; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}{% if lgu.office %}<div class="sub">{{ lgu.office }}</div>{% endif %}
<h1>GENERAL REVISION {{ v.year }} — COMPLETION REPORT</h1>
<div class="sub">{{ v.scope | join: ", " }}{% if v.province %}, {{ v.province }}{% endif %} · effective {{ v.effectiveDate | date_ph }}{% if v.completedOn %} · completed {{ v.completedOn | date_ph }}{% endif %}</div>
<table>
  <tr><th>Schedule of market values applied</th><td>{{ v.smv }}</td><th>Office order</th><td>{{ v.officeOrder | default: "—" }}</td><th>Ordinance</th><td>{{ v.ordinance | default: "—" }}</td></tr>
</table>
<h2>Units</h2>
<table>
  <tr><th>Compiled</th><th>Taken out</th><th>Not valued (failed)</th><th>Pending</th><th>Posted</th><th>Declared (new TD approved)</th><th>Independently appraised</th></tr>
  <tr><td class="num">{{ units.compiled }}</td><td class="num">{{ units.excluded }}</td><td class="num">{{ units.failed }}</td><td class="num">{{ units.pending }}</td>
      <td class="num">{{ units.posted }}</td><td class="num">{{ units.declared }}</td><td class="num">{{ units.independentlyAppraised }}</td></tr>
</table>
<h2>Values before and after, by classification (posted units)</h2>
<table>
  <tr><th>Classification</th><th>Units</th><th>Market value — before</th><th>Market value — after</th><th>Assessed value — before</th><th>Assessed value — after</th></tr>
  {% for c in byClassification %}
  <tr><td>{{ c.classification }}</td><td class="num">{{ c.units }}</td><td class="num">{{ c.marketValueBefore | money }}</td><td class="num">{{ c.marketValueAfter | money }}</td>
      <td class="num">{{ c.assessedValueBefore | money }}</td><td class="num">{{ c.assessedValueAfter | money }}</td></tr>
  {% else %}<tr><td colspan="6" class="empty">No posted unit.</td></tr>{% endfor %}
  <tr><th>Total</th><td></td><td class="num">{{ totals.marketValueBefore | money }}</td><td class="num">{{ totals.marketValueAfter | money }}</td>
      <td class="num">{{ totals.assessedValueBefore | money }}</td><td class="num">{{ totals.assessedValueAfter | money }}</td></tr>
</table>
<h2>Notices of assessment and records</h2>
<table>
  <tr><th>Notices</th><th>Draft</th><th>Issued, not served</th><th>Served</th><th>Latest receipt</th></tr>
  <tr><td class="num">{{ notices.total }}</td><td class="num">{{ notices.draft }}</td><td class="num">{{ notices.issued }}</td><td class="num">{{ notices.served }}</td>
      <td>{% if notices.latestReceipt %}{{ notices.latestReceipt | date_ph }}{% else %}—{% endif %}</td></tr>
</table>
<table>
  <tr><th>Register</th><th>Runs</th><th>Run before the waiting period (with a reason)</th></tr>
  {% for r in registers %}<tr><td>{{ r.kind }}</td><td class="num">{{ r.runs }}</td><td class="num">{{ r.overridden }}</td></tr>
  {% else %}<tr><td colspan="3" class="empty">No register run.</td></tr>{% endfor %}
</table>
<div class="foot">Appeals: {{ appeals.note }}</div>
{% if excludedUnits.size > 0 %}
<h2>Units taken out of the revision</h2>
<table><tr><th>PIN</th><th>Unit</th><th>Reason</th></tr>
  {% for u in excludedUnits %}<tr><td>{{ u.pin }}</td><td>{{ u.unit }}</td><td>{{ u.reason }}</td></tr>{% endfor %}</table>
{% endif %}
<div class="sig">Prepared by</div><div class="sig">Assessor</div>
<div class="foot">{{ form.title }} — form {{ form.code }} v{{ form.version }}. {{ form.legalBasis }}. Printed {{ issue.issuedAt | datetime_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.</div>
