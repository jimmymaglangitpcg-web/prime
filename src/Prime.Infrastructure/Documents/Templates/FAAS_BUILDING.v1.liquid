{% comment %}
  FAAS — Building & Other Improvements, after the MRPAAO Attachment 2
  (p.232–233; instructions p.149–153). Superseded manual: reference layout
  (docs/analysis/mrpaao-forms-model.md §13). Rows come prepared from PRIME's
  records; depreciation is not applied (plan A9: no configured table).
{% endcomment %}
{% assign f = faas %}{% assign a = appraisal %}{% assign p = a.property %}{% assign b = a.building %}
<style>
  .src { font-size: 8pt; border: 1px solid #555; padding: 2px 6px; margin-bottom: 6px; }
  .draft { border: 2px solid #b00; color: #b00; font-weight: bold; text-align: center; padding: 3px; margin-bottom: 6px; }
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 6px; }
  .lgu { text-align: center; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 5px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 9pt; vertical-align: top; }
  th { background: #eee; text-align: left; font-weight: bold; }
  .sec { background: #ddd; font-weight: bold; font-size: 9pt; }
  .num { text-align: right; white-space: nowrap; }
  .lbl { font-size: 7.5pt; color: #333; display: block; }
  .box { display: inline-block; width: 11px; height: 11px; border: 1px solid #000; text-align: center; line-height: 11px; font-size: 9pt; }
  .sig { height: 34px; }
</style>
<div class="src">Layout: MRPAAO 2004, Attachment 2 — superseded by the Local Assessment Manual; reference layout. Form {{ form.code }} v{{ form.version }}.</div>
{% if f.tdStatus != "Approved" and f.tdStatus != "Cancelled" %}<div class="draft">{{ f.tdStatus | upcase }} — NOT APPROVED</div>{% endif %}
{% if f.kind != "Building" %}<div class="draft">This Tax Declaration is for {{ f.kind }}; use the {{ f.kind | upcase }} FAAS.</div>{% endif %}
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}
<h1>REAL PROPERTY FIELD APPRAISAL &amp; ASSESSMENT SHEET — BUILDING &amp; OTHER IMPROVEMENTS</h1>

<table>
  <tr><td style="width:34%"><span class="lbl">ARP No.</span>{{ f.number | default: "(unnumbered)" }}</td>
      <td style="width:33%"><span class="lbl">TRANSACTION CODE</span>{{ f.transactionCode | default: "—" }}</td>
      <td><span class="lbl">PIN</span>{{ f.pin }}</td></tr>
</table>

<table>
  {% for o in f.owners %}
  <tr><td style="width:50%"><span class="lbl">{% if forloop.first %}OWNER{% endif %}</span>{{ o.name }}{% if o.sharePercent != 100 and o.role == "Owner" %} ({{ o.sharePercent | percent }}){% endif %}</td>
      <td style="width:25%"><span class="lbl">TIN</span>{{ o.tin | default: "—" }}</td><td><span class="lbl">Tel. No.</span>{{ o.contactNumber | default: "—" }}</td></tr>
  <tr><td colspan="3"><span class="lbl">Address</span>{{ o.address | default: "—" }}</td></tr>
  {% else %}
  <tr><td colspan="3"><span class="lbl">OWNER</span>No party recorded as of {{ f.effectivity.date | date_ph }}</td></tr>
  {% endfor %}
  {% for o in f.administrators %}
  <tr><td><span class="lbl">Administrator / Beneficial User ({{ o.roleLabel }})</span>{{ o.name }}</td>
      <td><span class="lbl">TIN</span>{{ o.tin | default: "—" }}</td><td><span class="lbl">Tel. No.</span>{{ o.contactNumber | default: "—" }}</td></tr>
  {% endfor %}
</table>

<table>
  <tr><td class="sec" style="width:50%">BUILDING LOCATION</td><td class="sec">LAND REFERENCE</td></tr>
  <tr><td>
      <span class="lbl">No./Street</span>{{ p.street | default: "—" }}
      <span class="lbl">Brgy./District</span>{{ p.barangay }}
      <span class="lbl">Municipality</span>{{ p.municipality }}
      <span class="lbl">Province/City</span>{{ p.province }}</td>
    <td>{% assign lr = f.landReference %}{% if lr %}
      <span class="lbl">Owner</span>{{ lr.owner | default: "—" }}
      <span class="lbl">{{ lr.titleType | default: "OCT/TCT/CLOA" }} No. / Survey No.</span>{{ lr.titleNumber | default: "—" }} / {{ lr.surveyNumber | default: "—" }}
      <span class="lbl">Lot No. / Blk. No.</span>{{ lr.lotNumber | default: "—" }} / {{ lr.blockNumber | default: "—" }}
      <span class="lbl">TD/ARP No.</span>{{ lr.tdNumber | default: "—" }}
      <span class="lbl">Area</span>{% if lr.area %}{{ lr.area | num }} {{ lr.areaUnit }}{% else %}—{% endif %}
      {% else %}Not linked to a land unit.{% endif %}</td></tr>
</table>

<table>
  <tr><td class="sec" colspan="4">GENERAL DESCRIPTION</td></tr>
  <tr><td><span class="lbl">Kind of Bldg.</span>{{ b.buildingType }}</td><td><span class="lbl">Structural Type</span>{{ b.structuralType }}</td>
      <td><span class="lbl">Bldg. Permit No. / Date Issued</span>{{ b.buildingPermitNumber | default: "—" }}{% if b.buildingPermitDate %} / {{ b.buildingPermitDate | date_ph }}{% endif %}</td>
      <td><span class="lbl">No. of Storeys</span>{{ b.numberOfStoreys }}</td></tr>
  <tr><td><span class="lbl">Condominium Certificate of Title (CCT)</span>{{ b.condominiumCertificateNumber | default: "—" }}</td>
      <td><span class="lbl">Certificate of Completion Issued On</span>{% if b.certificateOfCompletionDate %}{{ b.certificateOfCompletionDate | date_ph }}{% else %}—{% endif %}</td>
      <td><span class="lbl">Certificate of Occupancy Issued On</span>{% if b.certificateOfOccupancyDate %}{{ b.certificateOfOccupancyDate | date_ph }}{% else %}—{% endif %}</td>
      <td><span class="lbl">Bldg. Age (year completed)</span>{{ b.yearCompleted | default: b.yearConstructed | default: "—" }}</td></tr>
  <tr><td><span class="lbl">Date Constructed/Completed</span>{% if b.dateConstructed %}{{ b.dateConstructed | date_ph }}{% else %}{{ b.yearConstructed | default: "—" }}{% endif %}</td>
      <td><span class="lbl">Date Occupied</span>{% if b.dateOccupied %}{{ b.dateOccupied | date_ph }}{% else %}—{% endif %}</td>
      <td colspan="2"><span class="lbl">Area per floor</span>{% for fl in b.floors %}Floor {{ fl.floorNumber }}: {{ fl.area | num }} sqm{% unless forloop.last %}; {% endunless %}{% else %}—{% endfor %}
      <span class="lbl">Total Floor Area</span>{{ b.totalFloorArea | num }} sqm</td></tr>
  <tr><td colspan="4"><span class="lbl">FLOOR PLAN</span>Building plan or sketch of the floor plan attached separately (a photograph may also be attached).</td></tr>
</table>

<table>
  <tr><td class="sec" colspan="3">STRUCTURAL MATERIALS (Checklist)</td></tr>
  <tr><th>Structure part</th><th>Material</th><th>Floor</th></tr>
  {% for m in b.materials %}
  <tr><td>{{ m.structuralPart }}</td><td>{{ m.material }}</td><td>{% if m.floorNumber %}{{ m.floorNumber }}{% else %}All floors{% endif %}</td></tr>
  {% else %}
  <tr><td colspan="3">Checklist not filled.</td></tr>
  {% endfor %}
</table>

<table>
  <tr><td class="sec" colspan="3">ADDITIONAL ITEMS</td></tr>
  {% for i in f.additionalItems %}
  <tr><td>{{ i.kind }}</td><td>{{ i.description | default: "—" }}</td><td class="num">{{ i.cost | money }}</td></tr>
  {% else %}
  <tr><td colspan="3">None</td></tr>
  {% endfor %}
</table>

<table>
  <tr><td class="sec" colspan="8">PROPERTY APPRAISAL</td></tr>
  <tr><th>Use</th><th class="num">Floor area</th><th class="num">Unit Construction Cost /sq.m.</th><th class="num">Building Core</th>
      <th class="num">Cost of Additional Items</th><th class="num">Total Construction Cost</th><th class="num">Completion</th><th class="num">Market Value</th></tr>
  {% for r in f.buildingRows %}
  <tr><td>{{ r.actualUse }}</td><td class="num">{{ r.floorArea | num }}</td><td class="num">{{ r.unitConstructionCost | money }}</td><td class="num">{{ r.buildingCore | money }}</td>
      <td class="num">{{ r.additionalItems | money }}</td><td class="num">{{ r.totalConstructionCost | money }}</td>
      <td class="num">{{ r.completionPercent | percent }}</td><td class="num">{{ r.marketValue | money }}</td></tr>
  {% endfor %}
  <tr><td colspan="7">Depreciation Rate / Total % Depreciation / Depreciation Cost: not applied — no depreciation table is configured.</td>
      <td class="num"><b>{{ a.valuation.marketValue | money }}</b></td></tr>
</table>

<table>
  <tr><td class="sec" colspan="4">PROPERTY ASSESSMENT</td></tr>
  <tr><th>Actual Use</th><th class="num">Market Value</th><th class="num">Assessment Level</th><th class="num">Assessed Value</th></tr>
  {% for l in a.assessment.lines %}
  <tr><td>{{ l.actualUse }} ({{ l.classification }})</td><td class="num">{{ l.marketValue | money }}</td>
      <td class="num">{{ l.assessmentLevelPercent | percent }}</td><td class="num">{{ l.assessedValue | money }}</td></tr>
  {% endfor %}
  <tr><td class="num"><b>Total</b></td><td class="num"><b>{{ a.assessment.marketValue | money }}</b></td><td></td><td class="num"><b>{{ a.assessment.assessedValue | money }}</b></td></tr>
  <tr><td colspan="4">
    <span class="box">{% if f.taxability == "Taxable" %}X{% endif %}</span> Taxable &nbsp;&nbsp;
    <span class="box">{% if f.taxability != "Taxable" %}X{% endif %}</span> Exempt &nbsp;&nbsp;&nbsp;
    Effectivity of Assessment/Reassessment: <b>Q{{ f.effectivity.quarter }}</b> Qtr. <b>{{ f.effectivity.year }}</b> Yr.</td></tr>
</table>

<table>
  <tr><td style="width:33%"><span class="lbl">APPRAISED/ASSESSED BY</span><div class="sig"></div><b>{{ a.recordedBy | default: "—" }}</b><br>{{ a.recordedAt | date_ph }}</td>
  {% for s in a.signatures %}
    <td><span class="lbl">{{ s.label | upcase }}</span><div class="sig"></div><b>{{ s.name }}</b>{% if s.position %}<br>{{ s.position }}{% endif %}<br>{{ s.signedAt | date_ph }}</td>
  {% else %}
    <td><span class="lbl">RECOMMENDING APPROVAL</span><div class="sig"></div>—</td>
    <td><span class="lbl">APPROVED BY — Provincial/City/Municipal Assessor</span><div class="sig"></div>—</td>
  {% endfor %}
  </tr>
</table>

<table>
  <tr><td><span class="lbl">MEMORANDA</span>{{ f.memoranda | default: "—" }}</td></tr>
  <tr><td>Date of Entry in the Record of Assessment: <b>{% if a.recordEntry %}{{ a.recordEntry.postedAt | date_ph }}{% else %}—{% endif %}</b>
      &nbsp; By: <b>{% if a.recordEntry %}{{ a.recordEntry.postedBy | default: "—" }}{% else %}—{% endif %}</b></td></tr>
</table>

<table>
  <tr><td class="sec" colspan="4">RECORD OF SUPERSEDED ASSESSMENT</td></tr>
  {% if f.superseded %}
  <tr><td><span class="lbl">PIN</span>{{ f.superseded.pin }}</td><td><span class="lbl">ARP No.</span>{{ f.superseded.arpNumber | default: "—" }}</td>
      <td><span class="lbl">TD No.</span>{{ f.superseded.tdNumber }}</td><td><span class="lbl">Total Assessed Value</span>{% if f.superseded.totalAssessedValue %}{{ f.superseded.totalAssessedValue | money }}{% else %}—{% endif %}</td></tr>
  <tr><td colspan="2"><span class="lbl">Previous Owner</span>{{ f.superseded.previousOwner | default: "—" }}</td>
      <td colspan="2"><span class="lbl">Effectivity of Assessment</span>Q{{ f.superseded.effectivity.quarter }} {{ f.superseded.effectivity.year }}</td></tr>
  {% else %}
  <tr><td colspan="4">None — first assessment of this unit.</td></tr>
  {% endif %}
</table>
<div class="lbl">Issued {{ issue.issuedAt | date_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}. {{ form.legalBasis }}.</div>
