{% comment %}
  PRIME provisional layout (docs/FORMS-REVISION-PLAN.md A8). Neutral design
  built only from PRIME data — no LAM content, no official layout. Preview
  only: a statement is a point-in-time view (see
  StatementOfAccountFormDataProvider). Payments are Phase 9, so nothing is
  deducted and the footer says so.
{% endcomment %}
{% assign s = statement %}
<style>
  .hdr { text-align: center; margin-bottom: 10px; }
  .hdr .lgu { font-weight: bold; font-size: 12pt; }
  .hdr h1 { font-size: 15pt; margin: 6px 0 2px; }
  table { width: 100%; border-collapse: collapse; margin: 6px 0; }
  th, td { border: 1px solid #555; padding: 3px 5px; font-size: 9.5pt; vertical-align: top; }
  th { background: #eee; text-align: left; }
  .num { text-align: right; white-space: nowrap; }
  .meta td { border: none; padding: 1px 4px; }
  .total td { font-weight: bold; }
  .foot { font-size: 8pt; color: #333; margin-top: 10px; }
</style>
<div class="hdr">
  {% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% else %}<div class="lgu">[LGU name not configured]</div>{% endif %}
  {% if lgu.office %}<div>{{ lgu.office }}</div>{% endif %}
  <h1>{{ form.title }}</h1>
  <div>As of {{ s.generatedAt | date_ph }}</div>
</div>

<table class="meta">
  <tr><td><b>PIN</b></td><td>{{ property.pin }}</td></tr>
  <tr><td><b>Location</b></td><td>{% if property.street %}{{ property.street }}, {% endif %}{% if property.sitio %}{{ property.sitio }}, {% endif %}{{ property.barangay }}, {{ property.municipality }}, {{ property.province }}</td></tr>
  <tr><td><b>Declared in the name of</b></td><td>{% for o in owners %}{{ o.name }}{% if o.role != "Owner" and o.role != "UnknownOwner" %} ({{ o.roleLabel }}){% endif %}{% if o.isOwner and o.sharePercent != 100 %} ({{ o.sharePercent | percent }}){% endif %}{% unless forloop.last %}; {% endunless %}{% else %}—{% endfor %}</td></tr>
</table>

<table>
  <tr><th>Tax year</th><th>RPU</th><th>TD No.</th><th>As of</th><th class="num">Assessed value</th><th class="num">Tax</th><th class="num">Discount</th><th class="num">Penalty</th><th class="num">Interest</th><th class="num">Amount due</th></tr>
  {% for b in s.bills %}
  <tr><td>{{ b.taxYear }}</td><td>{{ b.rpuNumber }}</td><td>{{ b.taxDeclarationNumber }}</td><td>{{ b.asOfDate | date_ph }}</td>
      <td class="num">{{ b.assessedValue | money }}</td><td class="num">{{ b.tax | money }}</td><td class="num">{{ b.discount | money }}</td>
      <td class="num">{{ b.penalty | money }}</td><td class="num">{{ b.interest | money }}</td><td class="num">{{ b.total | money }}</td></tr>
  {% else %}
  <tr><td colspan="10">No posted bills.</td></tr>
  {% endfor %}
  <tr class="total"><td colspan="9" class="num">TOTAL BILLED</td><td class="num">{{ s.totalBilled | money }}</td></tr>
</table>

<div class="foot">
  Each bill's amounts are computed as of its own date. Payments are not yet recorded in PRIME, so none are deducted.
  Printed {{ issue.issuedAt | date_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.
  Form {{ form.code }} v{{ form.version }} — {{ form.legalBasis }}.
</div>
