{% comment %}
  Tax Map Control Roll, after the MRPAAO Attachment 5 (p.158–159). Superseded manual: reference
  layout (docs/analysis/mrpaao-forms-model.md §15). Rows are derived from the
  FAAS in force on the run's date; issuing the run freezes them.
{% endcomment %}
{% assign r = register %}
<style>
  @page { size: landscape; }
  .src { font-size: 8pt; border: 1px solid #555; padding: 2px 6px; margin-bottom: 6px; }
  .draft { border: 2px solid #b00; color: #b00; font-weight: bold; text-align: center; padding: 3px; margin-bottom: 6px; }
  h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 6px; }
  .lgu { text-align: center; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
  td, th { border: 1px solid #000; padding: 2px 4px; font-size: 8pt; vertical-align: top; }
  th { background: #eee; font-weight: bold; text-align: center; }
  .num { text-align: right; white-space: nowrap; }
  .hd td { border: none; font-size: 9pt; padding: 1px 4px; }
  .empty { text-align: center; font-style: italic; }
  .foot { font-size: 7.5pt; margin-top: 6px; }
</style>
<div class="src">Layout: MRPAAO 2004, Attachment 5 — superseded by the Local Assessment Manual; reference layout. Form {{ form.code }} v{{ form.version }}.</div>
{% if r.formCode != form.code %}<div class="draft">This run is a {{ r.kind }} register; print it with form {{ r.formCode }}.</div>{% endif %}
{% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% endif %}
<h1>TAX MAP CONTROL ROLL</h1>
<table class="hd">
  <tr><td>Province: <b>{{ r.province }}</b> <small>({{ r.provinceCode | default: "—" }})</small></td>
      <td>City/Municipality: <b>{{ r.municipality }}</b> <small>({{ r.municipalityCode | default: "—" }})</small></td>
      <td>Barangay: <b>{{ r.barangay }}</b> <small>({{ r.barangayCode | default: "—" }})</small></td>
      <td>As of <b>{{ r.asOf | date_ph }}</b></td></tr>
</table>
<table>
  <tr><th rowspan="2">Assessor's Lot No.</th><th rowspan="2">Cadastral / Survey No.</th><th rowspan="2">Lot / Blk</th><th rowspan="2">Title No.</th>
      <th rowspan="2">Area</th><th rowspan="2">Class</th><th rowspan="2">Declared Owner</th><th rowspan="2">ARP No.</th><th rowspan="2">TD No.</th>
      <th colspan="3">Improvements</th><th rowspan="2">Remarks</th></tr>
  <tr><th>Bldg (No.)</th><th>Mach.</th><th>Others</th></tr>
  {% for x in rows %}
  <tr><td>{{ x.assessorLotNumber }}</td><td>{{ x.surveyNumber | default: "—" }}</td><td>{{ x.lotNumber | default: "—" }} / {{ x.blockNumber | default: "—" }}</td>
      <td>{{ x.titleNumber | default: "—" }}</td><td class="num">{% if x.area %}{{ x.area | num }} {{ x.areaUnit }}{% else %}—{% endif %}</td>
      <td>{{ x.classCode }}</td><td>{{ x.owner }}</td><td>{{ x.arpNumber | default: "—" }}</td><td>{{ x.tdNumber }}</td>
      <td class="num">{% if x.buildings > 0 %}{{ x.buildings }}{% endif %}</td><td style="text-align:center">{% if x.machinery %}X{% endif %}</td>
      <td>{{ x.others }}</td><td>{{ x.remarks }}</td></tr>
  {% else %}<tr><td colspan="13" class="empty">No land parcel is declared in this barangay as of this date.</td></tr>{% endfor %}
</table>
<p style="font-size:8pt">Parcels listed: <b>{{ rows | size }}</b>.</p>
<table class="hd" style="margin-top:28px"><tr><td style="width:50%"></td>
  <td style="text-align:center"><div style="border-top:1px solid #000; display:inline-block; min-width:260px; padding-top:2px">Provincial/City/Municipal Assessor</div></td></tr></table>
<div class="foot">Location codes are PSGC codes (the manual's location index numbers are not recorded — DOMAIN VERIFICATION REQUIRED).
  {% if r.remarks %}Remarks: {{ r.remarks }}. {% endif %}Printed {{ issue.issuedAt | date_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}. {{ form.legalBasis }}.</div>
