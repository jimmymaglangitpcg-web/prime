{% comment %}
  PRIME provisional layout (docs/FORMS-REVISION-PLAN.md). Neutral design built
  only from PRIME data — no LAM content, no 2004/2006 manual layout.
{% endcomment %}
<style>
  .hdr { text-align: center; margin-bottom: 10px; }
  .hdr .lgu { font-weight: bold; font-size: 12pt; }
  .hdr h1 { font-size: 15pt; margin: 6px 0 2px; }
  table { width: 100%; border-collapse: collapse; margin: 6px 0; }
  th, td { border: 1px solid #555; padding: 3px 5px; font-size: 9.5pt; vertical-align: top; }
  th { background: #eee; text-align: left; }
  .num { text-align: right; white-space: nowrap; }
  .meta td { border: none; padding: 1px 4px; }
  .total td { font-weight: bold; }
  .foot { font-size: 8pt; color: #333; margin-top: 10px; }
</style>
<div class="hdr">
  {% if lgu.name %}<div class="lgu">{{ lgu.name }}</div>{% else %}<div class="lgu">[LGU name not configured]</div>{% endif %}
  {% if lgu.office %}<div>{{ lgu.office }}</div>{% endif %}
  <h1>{{ form.title }}</h1>
  <div>Tax Year {{ bill.taxYear }}{% if bill.billNumber %} · Bill No. {{ bill.billNumber }}{% endif %}</div>
</div>

<table class="meta">
  <tr><td><b>PIN</b></td><td>{{ property.pin }}</td><td><b>TD No.</b></td><td>{{ bill.taxDeclarationNumber }}</td></tr>
  <tr><td><b>Location</b></td><td>{% if property.street %}{{ property.street }}, {% endif %}{{ property.barangay }}, {{ property.municipality }}, {{ property.province }}</td>
      <td><b>RPU</b></td><td>{{ bill.rpuNumber }}</td></tr>
  <tr><td><b>Declared owner(s)</b></td><td colspan="3">{% for o in owners %}{{ o.name }}{% if o.sharePercent != 100 %} ({{ o.sharePercent | percent }}){% endif %}{% unless forloop.last %}; {% endunless %}{% else %}—{% endfor %}</td></tr>
  <tr><td><b>Assessed value</b></td><td>{{ bill.assessedValue | money }}</td><td><b>Amount due as of</b></td><td>{{ bill.asOfDate | date_ph }}</td></tr>
</table>

<table>
  <tr><th>Tax type</th><th class="num">Rate</th><th class="num">Annual tax</th></tr>
  {% for t in taxTypes %}
  <tr><td>{{ t.name }}</td><td class="num">{{ t.ratePercent | percent }}</td>
      <td class="num">{{ t.annualTax | money }}{% if t.capLimit and t.annualTax < t.computedAnnualTax %} (capped from {{ t.computedAnnualTax | money }}){% endif %}</td></tr>
  {% endfor %}
</table>

<table>
  <tr><th>Inst.</th><th>Due</th><th>Tax type</th><th>Item</th><th>Explanation</th><th class="num">Amount</th></tr>
  {% for l in lines %}
  <tr><td>{{ l.installment }}</td><td>{{ l.dueDate }}</td><td>{{ l.taxType }}</td><td>{{ l.component }}</td><td>{{ l.explanation }}</td><td class="num">{{ l.amount | money }}</td></tr>
  {% endfor %}
  <tr class="total"><td colspan="5" class="num">TOTAL AMOUNT DUE</td><td class="num">{{ bill.total | money }}</td></tr>
</table>

{% if bill.notes %}<p><b>Notes:</b> {{ bill.notes }}</p>{% endif %}

<div class="foot">
  Amounts assume full payment on {{ bill.asOfDate | date_ph }}; rules in force on {{ bill.rulesAsOfDate | date_ph }}.
  Issued {{ issue.issuedAt | date_ph }}{% if issue.issuedBy %} by {{ issue.issuedBy }}{% endif %}.
  Form {{ form.code }} v{{ form.version }} — {{ form.legalBasis }}.
</div>
